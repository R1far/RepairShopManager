<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tvStockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stock_title"
            android:textSize="@dimen/text_size_title"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_search_view"
            android:elevation="@dimen/elevation_card"
            app:queryHint="@string/hint_search_stock" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewStock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_large" />

        <TextView
            android:id="@+id/tvEmptyStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_stock_list"
            android:textSize="@dimen/text_size_body"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_large"
        android:contentDescription="@string/btn_create_stock"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
