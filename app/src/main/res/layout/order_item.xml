<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    app:cardElevation="@dimen/elevation_card"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Header: ID и статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#12345"
                android:textSize="@dimen/text_size_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Новый"
                android:textSize="@dimen/text_size_small"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_blue_dark"
                android:paddingStart="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Объект ремонта с меткой -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Объект:"
            android:textSize="@dimen/text_size_small"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvObjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="iPhone 12"
            android:textSize="@dimen/text_size_body"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- Клиент с меткой -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Клиент:"
            android:textSize="@dimen/text_size_small"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Иванов Иван Иванович"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvClientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+7 999 123 45 67"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- Total Price and Items Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 ₽"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvOrderItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Усл: 0 | Зап: 0"
                android:textSize="@dimen/text_size_caption"
                android:textColor="?attr/colorOnSurfaceVariant" />
        
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
