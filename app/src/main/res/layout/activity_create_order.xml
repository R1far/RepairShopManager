<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            android:id="@+id/tvCreateOrderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_order_title"
            android:textSize="@dimen/text_size_title"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/spacing_large" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/hint_object_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etObjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/hint_client_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etClientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/hint_client_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etClientPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/hint_problem_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProblemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_master"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="@dimen/spacing_tiny" />

        <TextView
            android:id="@+id/tvMasterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/text_size_body"
            android:textColor="?attr/colorOnSurface"
            android:padding="@dimen/spacing_medium"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="@dimen/spacing_large" />

        <!-- Services Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_services"
            android:textSize="@dimen/text_size_subtitle"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:id="@+id/llServicesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/spacing_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_service"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- Parts Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_parts"
            android:textSize="@dimen/text_size_subtitle"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:id="@+id/llPartsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/spacing_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_part"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- Total Price Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_large">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_total"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginEnd="@dimen/spacing_small" />

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 ₽"
                android:gravity="end"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveOrder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_save_order"
            android:textSize="@dimen/text_size_body" />

    </LinearLayout>

</ScrollView>
